LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
TYPHOON_API_KEY=your_typhoon_api_key_here
CSV_PATH=foods_master_v2.csv
MODEL_PATH=models/ann_model.keras
DATABASE_URL="postgresql://user:password@localhost:5432/Chatbot"

# ── ไม่บังคับ (มีค่าเริ่มต้น) ──────────────────────────────────────
# Bandit: linucb | knn | ab (แบ่งผู้ใช้ครึ่ง/ครึ่งเพื่อเทียบ)
BANDIT_POLICY=linucb
# CNN (THFOOD-100, Entry 62) — ค่าเริ่มต้น: โหลดโมเดลจาก CNN_PACKAGE_DIR เข้าแชทบอทเลย (ต้องมี torch + torchvision)
CNN_PACKAGE_DIR=THFOOD100_Chatbot_Inference/thfood100_inference
CNN_DEVICE=cpu
# หรือใช้ server.py แยก (พอร์ต 8081) แทน:
# CNN_API_URL=http://127.0.0.1:8081/api/predict
CNN_MIN_CONFIDENCE=0.40
# โหมดไฟล์ .keras (เดิม) — ใช้เมื่อไม่ตั้ง CNN_API_URL; ไม่มีไฟล์ = ปิดฟีเจอร์รูปภาพ
CNN_MODEL_PATH=models/cnn_thfood100.keras
CNN_IMG_SIZE=224
CNN_RESCALE=1
# ทดสอบแบบไม่มี LINE secret เท่านั้น (ห้ามเปิดตอน deploy)
ALLOW_UNSIGNED_WEBHOOK=0
# ฟอร์ม LIFF ต้องยืนยันตัวตนด้วย LINE access token (ปิด=0 เฉพาะทดสอบนอก LINE)
REQUIRE_LIFF_AUTH=1
# แจ้งเตือนมื้ออาหาร/สรุปรายสัปดาห์ (ผู้ใช้ต้องพิมพ์ "เปิดแจ้งเตือน" เอง) — 0 = ปิดทั้งระบบ
REMINDERS_ENABLED=1
